{
  "name": "paper-irl",
  "private": true,
  "version": "0.1.0",
  "description": "IRL paper.io freeplay GPS inside a campus boundary — Keller Hall MVP",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter @paper-irl/rules test && pnpm sim:lobby && pnpm verify:mobile",
    "sim:lobby": "pnpm --filter @paper-irl/rules build && pnpm --filter @paper-irl/sim start",
    "verify:mobile": "pnpm --filter @paper-irl/mobile verify:bundle",
    "demo": "pnpm --filter @paper-irl/web dev",
    "dev:server": "pnpm --filter @paper-irl/server dev",
    "mobile": "pnpm --filter @paper-irl/rules build && EXPO_PUBLIC_LAUNCH=human pnpm --filter @paper-irl/mobile android",
    "mobile:join-bots": "pnpm --filter @paper-irl/rules build && EXPO_PUBLIC_LAUNCH=join-bots pnpm --filter @paper-irl/mobile android",
    "mobile:host-bots": "pnpm --filter @paper-irl/rules build && EXPO_PUBLIC_LAUNCH=host-bots pnpm --filter @paper-irl/mobile android",
    "mobile:ios": "pnpm --filter @paper-irl/rules build && EXPO_PUBLIC_LAUNCH=human pnpm --filter @paper-irl/mobile ios",
    "mobile:ios:join-bots": "pnpm --filter @paper-irl/rules build && EXPO_PUBLIC_LAUNCH=join-bots pnpm --filter @paper-irl/mobile ios",
    "mobile:ios:host-bots": "pnpm --filter @paper-irl/rules build && EXPO_PUBLIC_LAUNCH=host-bots pnpm --filter @paper-irl/mobile ios",
    "mobile:prebuild:ios": "pnpm --filter @paper-irl/mobile prebuild:ios",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
