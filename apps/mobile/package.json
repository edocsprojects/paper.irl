{
  "name": "@paper-irl/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "verify:bundle": "node ./scripts/verify-bundle-entry.js",
    "verify:rules-metro": "node ./scripts/verify-rules-metro-resolve.js",
    "verify:trails": "node ./scripts/verify-map-trails.js && VERIFY_TRAILS_BREAK=1 node ./scripts/verify-map-trails.js && node ./scripts/verify-trail-paint-payload.js && VERIFY_TRAIL_PAINT_BREAK=1 node ./scripts/verify-trail-paint-payload.js",
    "verify:metro": "node ./scripts/metro-http-probe.js",
    "ios:clean": "node ./scripts/ios-clean.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "human": "EXPO_PUBLIC_LAUNCH=human expo start --android",
    "join-bots": "EXPO_PUBLIC_LAUNCH=join-bots expo start --android",
    "host-bots": "EXPO_PUBLIC_LAUNCH=host-bots expo start --android",
    "human:ios": "EXPO_PUBLIC_LAUNCH=human expo run:ios",
    "join-bots:ios": "EXPO_PUBLIC_LAUNCH=join-bots expo run:ios",
    "host-bots:ios": "EXPO_PUBLIC_LAUNCH=host-bots expo run:ios"
  },
  "dependencies": {
    "@babel/runtime": "^7.20.0",
    "@paper-irl/rules": "workspace:*",
    "expo": "~52.0.46",
    "expo-constants": "~17.0.8",
    "expo-location": "~18.0.10",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.7.3"
  }
}
