    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@paper-irl/rules": "workspace:*",
    "fastify": "^5.2.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
