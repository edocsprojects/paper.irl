# Local Postgres (docker compose). Not required for `pnpm sim:lobby`.
DATABASE_URL=postgres://paper:paper@localhost:5432/paper_irl
PORT=3001
# Add when building the Android map:
# GOOGLE_MAPS_API_KEY_ANDROID=

# Google sign-in via Supabase (free tier). Server verifies tokens with these:
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Web app (Vite) reads the same values with a VITE_ prefix:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Event length (default 7 days). Shorten for testing, e.g. 600000 = 10 min.
# EVENT_DURATION_MS=604800000
